{"$schema":"https://kiro.dev/schemas/hooks.json","description":"On save: run the full test suite so a broken change is caught immediately. Report-only repo: tests are the safety net.","hooks":[{"actions":[{"command":"python3 -m unittest discover -s tests -v","timeoutSeconds":120,"type":"command","workingDirectory":"."}],"name":"on-save-run-tests","trigger":{"event":"onSave","filePattern":"server/**/*.py"}},{"actions":[{"command":"python3 -m py_compile \"$FILE\"","timeoutSeconds":30,"type":"command","workingDirectory":"."}],"name":"on-save-compile-check","trigger":{"event":"onSave","filePattern":"**/*.py"}}]}